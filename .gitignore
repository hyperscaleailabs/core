# OS
.DS_Store
Thumbs.db

# Editors / IDEs
.idea/
.vscode/
*.swp

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
dist/
build/
*.egg-info/

# Node
node_modules/
.npm/
*.tsbuildinfo

# Astro / Vercel build state (atlas). `dist/` is covered above; these are the
# generated caches and deploy scratch that must never reach a public tree.
.astro/
.vercel/

# Atlas ingestion cache: snapshots of fetched sources, regenerated each run.
atlas/pipeline/cache/*
!atlas/pipeline/cache/.gitkeep

# Env and local secrets (never committed, also caught by policy checks)
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Terraform: state files routinely contain resolved secrets and resource identity,
# and are never appropriate in a public repository. Variable files are per-deployment.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log

# Cluster credentials
kubeconfig
*.kubeconfig
.kube/

# Coverage
.coverage
htmlcov/

# Logs and local data
*.log
data/local/
tmp/
