# Copy to .env for local development. NEVER commit real secrets.
# deploy/scripts/deploy-local.sh reads this to create k8s Secrets.

# PostgreSQL (control plane)
POSTGRES_USER=asc
POSTGRES_PASSWORD=change-me-local
POSTGRES_DB=agentsim

# MinIO (object storage for trajectory artifacts)
MINIO_ROOT_USER=asc
MINIO_ROOT_PASSWORD=change-me-local

# Superset
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=change-me-local
SUPERSET_SECRET_KEY=change-me-local-please-rotate

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-local

# Kafka bootstrap (in-cluster service DNS)
KAFKA_BOOTSTRAP=kafka.data.svc.cluster.local:9092

# Observability dashboard base URLs injected into operator-web (/config.js)
GRAFANA_BASE_URL=http://grafana.localhost:8080
SUPERSET_BASE_URL=http://superset.localhost:8080
