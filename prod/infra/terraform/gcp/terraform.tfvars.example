# Copy to terraform.tfvars and fill in. Never commit real tfvars.
project_id     = "your-gcp-project-id"
region         = "us-central1"
zone           = "us-central1-a"
machine_type   = "e2-standard-8"
data_disk_gb   = 100
# Restrict access to your IP(s) — SSH, ingress, and kube-apiserver are limited to these.
operator_cidrs = ["203.0.113.10/32"]
