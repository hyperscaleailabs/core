{
  "type": "kafka",
  "spec": {
    "dataSchema": {
      "dataSource": "failure_stats",
      "timestampSpec": { "column": "windowEnd", "format": "auto" },
      "dimensionsSpec": {
        "dimensions": ["runId", "failureClassification"]
      },
      "metricsSpec": [
        { "name": "events", "type": "count" },
        { "name": "sum_count", "type": "longSum", "fieldName": "count" },
        { "name": "max_p95_latency", "type": "doubleMax", "fieldName": "p95LatencyMs" },
        { "name": "sum_dup_risk", "type": "longSum", "fieldName": "duplicateTransactionRisk" }
      ],
      "granularitySpec": {
        "type": "uniform",
        "segmentGranularity": "hour",
        "queryGranularity": "minute",
        "rollup": true
      }
    },
    "ioConfig": {
      "topic": "sim.failure.stats.v1",
      "inputFormat": { "type": "json" },
      "consumerProperties": {
        "bootstrap.servers": "kafka.data.svc.cluster.local:9092"
      },
      "taskCount": 1,
      "replicas": 1,
      "useEarliestOffset": true
    },
    "tuningConfig": { "type": "kafka", "maxRowsInMemory": 50000 }
  }
}
