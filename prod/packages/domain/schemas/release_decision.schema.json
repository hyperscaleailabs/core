{
  "$defs": {
    "DecisionStatus": {
      "enum": [
        "Passed",
        "Passed with warnings",
        "Manual review",
        "Blocked"
      ],
      "title": "DecisionStatus",
      "type": "string"
    },
    "GateOperator": {
      "enum": [
        "gte",
        "lte",
        "eq",
        "lt",
        "gt"
      ],
      "title": "GateOperator",
      "type": "string"
    },
    "GateResult": {
      "properties": {
        "actual_value": {
          "title": "Actual Value",
          "type": "number"
        },
        "gate_id": {
          "title": "Gate Id",
          "type": "string"
        },
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "operator": {
          "$ref": "#/$defs/GateOperator"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "provisional": {
          "default": false,
          "title": "Provisional",
          "type": "boolean"
        },
        "related_trajectory_ids": {
          "items": {
            "type": "string"
          },
          "title": "Related Trajectory Ids",
          "type": "array"
        },
        "sample_size": {
          "title": "Sample Size",
          "type": "integer"
        },
        "scope": {
          "default": "run",
          "title": "Scope",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/GateSeverity"
        },
        "threshold": {
          "title": "Threshold",
          "type": "number"
        }
      },
      "required": [
        "gate_id",
        "metric",
        "operator",
        "actual_value",
        "threshold",
        "severity",
        "sample_size",
        "passed"
      ],
      "title": "GateResult",
      "type": "object"
    },
    "GateSeverity": {
      "enum": [
        "warning",
        "manual_review",
        "blocking"
      ],
      "title": "GateSeverity",
      "type": "string"
    }
  },
  "properties": {
    "blocking_gates": {
      "items": {
        "$ref": "#/$defs/GateResult"
      },
      "title": "Blocking Gates",
      "type": "array"
    },
    "explanations": {
      "items": {
        "type": "string"
      },
      "title": "Explanations",
      "type": "array"
    },
    "passed_gates": {
      "items": {
        "$ref": "#/$defs/GateResult"
      },
      "title": "Passed Gates",
      "type": "array"
    },
    "reproducibility": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Reproducibility",
      "type": "object"
    },
    "review_gates": {
      "items": {
        "$ref": "#/$defs/GateResult"
      },
      "title": "Review Gates",
      "type": "array"
    },
    "sample_size": {
      "default": 0,
      "title": "Sample Size",
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/DecisionStatus"
    },
    "version_identifiers": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Version Identifiers",
      "type": "object"
    },
    "warnings": {
      "items": {
        "$ref": "#/$defs/GateResult"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "status"
  ],
  "title": "ReleaseDecision",
  "type": "object"
}
