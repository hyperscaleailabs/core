---
import { REPO_BROWSE_URL } from '../lib/repo';

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-[var(--color-line)]">
  <div class="mx-auto grid max-w-6xl gap-8 px-5 py-12 md:grid-cols-4">
    <div class="md:col-span-2">
      <div class="flex items-center gap-2.5">
        <span class="grid h-7 w-7 place-items-center rounded-lg border border-[var(--color-line)] bg-[var(--color-ink-800)] font-mono text-sm text-[var(--color-cyan)]">◆</span>
        <span class="font-semibold text-[var(--color-fog-100)]">Agentic Atlas</span>
      </div>
      <p class="mt-3 max-w-md text-sm text-[var(--color-fog-400)]">
        A living, open technical reference for engineers and architects building
        AI-agent systems in production. Content is Markdown, versioned in Git, and
        continuously extended by an ingestion pipeline.
      </p>
    </div>

    <div>
      <h4 class="text-xs font-semibold uppercase tracking-wider text-[var(--color-fog-300)]">Explore</h4>
      <ul class="mt-3 space-y-2 text-sm text-[var(--color-fog-400)]">
        <li><a class="hover:text-[var(--color-fog-100)]" href="/foundations">Foundations</a></li>
        <li><a class="hover:text-[var(--color-fog-100)]" href="/frameworks">Frameworks</a></li>
        <li><a class="hover:text-[var(--color-fog-100)]" href="/comparisons">Comparisons</a></li>
        <li><a class="hover:text-[var(--color-fog-100)]" href="/case-studies">Case studies</a></li>
      </ul>
    </div>

    <div>
      <h4 class="text-xs font-semibold uppercase tracking-wider text-[var(--color-fog-300)]">Project</h4>
      <ul class="mt-3 space-y-2 text-sm text-[var(--color-fog-400)]">
        <li><a class="hover:text-[var(--color-fog-100)]" href="/about">About & methodology</a></li>
        <li><a class="hover:text-[var(--color-fog-100)]" href="/licenses">Licenses & attribution</a></li>
        <li><a class="hover:text-[var(--color-fog-100)]" href="/rss.xml">RSS feed</a></li>
        <li><a class="hover:text-[var(--color-fog-100)]" href={REPO_BROWSE_URL}>Contribute on GitHub</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-[var(--color-line)]">
    <div class="mx-auto flex max-w-6xl flex-col gap-2 px-5 py-5 text-xs text-[var(--color-fog-400)] sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} Agentic Atlas contributors.</p>
      <p>
        Code under <a class="link-accent" href="/licenses">Apache 2.0</a> ·
        Content under <a class="link-accent" href="/licenses">CC BY 4.0</a> ·
        Third-party material remains under its own license.
      </p>
    </div>
  </div>
</footer>
