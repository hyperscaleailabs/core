---
import { REPO_BROWSE_URL } from '../lib/repo';

const nav = [
  { href: '/foundations', label: 'Foundations' },
  { href: '/frameworks', label: 'Frameworks' },
  { href: '/patterns', label: 'Patterns' },
  { href: '/production', label: 'Production' },
  { href: '/comparisons', label: 'Comparisons' },
  { href: '/case-studies', label: 'Case Studies' },
  { href: '/lab', label: 'Lab Notes' },
  { href: '/news', label: 'News' },
];
const path = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-[var(--color-line)] bg-[color-mix(in_srgb,var(--color-ink-950)_82%,transparent)] backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5">
    <a href="/" class="group flex items-center gap-2.5">
      <span class="grid h-8 w-8 place-items-center rounded-lg border border-[var(--color-line)] bg-[var(--color-ink-800)] font-mono text-[var(--color-cyan)]">◆</span>
      <span class="font-semibold tracking-tight text-[var(--color-fog-100)]">Agentic<span class="text-[var(--color-cyan)]">Atlas</span></span>
    </a>

    <nav class="hidden items-center gap-1 md:flex">
      {nav.map((item) => {
        const active = path.startsWith(item.href);
        return (
          <a
            href={item.href}
            class:list={[
              'rounded-md px-3 py-1.5 text-sm transition-colors',
              active
                ? 'text-[var(--color-fog-100)] bg-[var(--color-ink-800)]'
                : 'text-[var(--color-fog-400)] hover:text-[var(--color-fog-100)]',
            ]}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <div class="flex items-center gap-3">
      <a
        href="/learning-paths"
        class="hidden rounded-md border border-[var(--color-line)] px-3 py-1.5 text-sm text-[var(--color-fog-300)] transition-colors hover:border-[var(--color-cyan-dim)] hover:text-[var(--color-fog-100)] sm:block"
      >
        Learning paths
      </a>
      <a
        href={REPO_BROWSE_URL}
        class="grid h-9 w-9 place-items-center rounded-md border border-[var(--color-line)] text-[var(--color-fog-300)] transition-colors hover:text-[var(--color-fog-100)]"
        aria-label="GitHub repository"
      >
        <svg viewBox="0 0 16 16" width="17" height="17" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"/>
        </svg>
      </a>
    </div>
  </div>
</header>
