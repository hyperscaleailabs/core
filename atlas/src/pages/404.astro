---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found" description="That page does not exist.">
  <div class="mx-auto grid max-w-6xl place-items-center px-5 py-32 text-center">
    <p class="font-mono text-6xl text-[var(--color-cyan)]">404</p>
    <h1 class="mt-4 text-2xl font-bold text-[var(--color-fog-100)]">This node isn't on the atlas</h1>
    <p class="mt-2 text-[var(--color-fog-400)]">The page you're looking for doesn't exist or has moved.</p>
    <a href="/" class="mt-6 rounded-lg bg-[var(--color-cyan)] px-5 py-2.5 font-medium text-[var(--color-ink-950)]">Back to home</a>
  </div>
</BaseLayout>
