---
import { getCollection, render, type CollectionEntry, type CollectionKey } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { SECTION_META } from '../../lib/content';

export async function getStaticPaths() {
  const sections = Object.keys(SECTION_META) as CollectionKey[];
  const grouped = await Promise.all(sections.map((s) => getCollection(s)));
  const entries = grouped.flat() as CollectionEntry<CollectionKey>[];
  return entries.map((entry) => ({
    params: { section: entry.collection, slug: entry.id },
    props: { entry },
  }));
}

type Props = { entry: CollectionEntry<CollectionKey> };
const { entry } = Astro.props as Props;
const { Content, headings } = await render(entry);
---

<ArticleLayout entry={entry} headings={headings}>
  <Content />
</ArticleLayout>
